{
  "name": "blog-server",
  "version": "1.0.0",
  "description": "博客后端",
  "private": true,
  "egg": {
    "declarations": true
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "egg": "^3.17.5",
    "egg-cors": "^3.0.1",
    "egg-multipart": "^3.5.0",
    "egg-scripts": "2",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "egg-bin": "6",
    "egg-mock": "5",
    "eslint": "8",
    "eslint-config-egg": "13"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "egg-scripts start --daemon --title=egg-server-blog-server",
    "stop": "egg-scripts stop --title=egg-server-blog-server",
    "dev": "egg-bin dev",
    "test": "npm run lint -- --fix && npm run test:local",
    "test:local": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint .",
    "ci": "npm run lint && npm run cov",
    "build:articles": "node scripts/generate-article-index.js",
    "extract:images": "node scripts/extract-base64-images.js",
    "optimize": "npm run extract:images && npm run build:articles"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "",
  "license": "MIT"
}
